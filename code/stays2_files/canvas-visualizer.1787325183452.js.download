und-repeat: no-repeat;\n    background-position: center;\n    padding: 12px;\n    border-radius: 4px;\n    cursor: pointer;\n}\n\n.search-clear-button:hover {\n    background-color: #ececec;\n    background-image: url(${A});\n}\n\n.search-clear-button:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 2px;\n}\n\n@media (max-width: 600px) {\n    .icon-settings-header {\n        margin-left: 0px;\n    }\n}\n\n.icon-settings-container {\n    display: flex;\n    align-items: center;\n}\n\n.color-buttons-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    background-color: #faf8ff;\n    padding: 3px 10px;\n    width: fit-content;\n    border: 1px solid #d0d0d0;\n    border-radius: 5px;\n    box-shadow: 0px 0px 2px 0px #00000040;\n    cursor: pointer;\n    height: 45px;\n}\n\n.color-picker-container {\n    position: relative;\n    width: 40px;\n    height: 40px;\n}\n\n.icon-color-picker {\n    cursor: pointer;\n    position: absolute;\n    top: 30px;\n    left: -200px;\n    opacity: 0;\n    width: 24px;\n    height: 24px;\n    visibility: hidden;\n}\n\n.simple-color-button {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 4px;\n    border-radius: 5px;\n}\n\n.simple-color-button:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: -2px;\n}\n\n.simple-color-button-inner {\n    width: 28px;\n    height: 28px;\n    border-radius: 5px;\n}\n\n.text-field-error-icon {\n    background-image: url(${y});\n    background-repeat: no-repeat;\n    background-size: contain;\n    width: 16px;\n    height: 16px;\n}\n\n.search-field-search-icon {\n    background-image: url(${p});\n    background-repeat: no-repeat;\n    background-size: contain;\n    min-width: 18px;\n    filter: invert(0.7);\n    background-position: center;\n    margin-left: 15px;\n}\n\n/* Field validation styles */\n.field-validation-check-container {\n    margin-top: 5px;\n}\n\n.field-validation-check {\n    display: flex;\n}\n\n.field-validation-check-icon {\n    background-repeat: no-repeat;\n    background-size: cover;\n    min-width: 22px;\n    min-height: 22px;\n    width: 22px;\n    height: 22px;\n    margin-right: 5px;\n}\n\n.field-validation-check-icon-pass {\n    background-image: url(${h});\n}\n\n.field-validation-check-icon-fail {\n    background-image: url(${j});\n}\n\n.field-validation-check-prompt {\n    word-break: break-word;\n    font-size: 14px;\n    line-height: 1.5;\n}\n/* Field validation styles end */\n\n/* common Filter Menu styles */\n.common-filter-container {\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    height: 40px;\n    border-radius: 4px;\n    height: 35px;\n    width: 35px;\n    justify-content: center;\n}\n\n.common-filter-container:hover {\n    background-color: #ececec;\n}\n\n.common-filter-icon-container {\n    background-color: transparent;\n    display: flex;\n    position: relative;\n    width: fit-content;\n    height: 100%;\n    margin: 0;\n    align-items: center;\n    border-radius: 4px;\n    border: none;\n    color: inherit;\n    font-size: inherit;\n    font-weight: inherit;\n    text-align: inherit;\n    text-decoration: none;\n    cursor: pointer;\n    padding: 0;\n}\n\n.common-filter-icon-container:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: -2px;\n}\n\n.common-filter-filters-applied {\n    position: absolute;\n    top: -8px;\n    right: -7px;\n    color: white;\n    background: #0b6f85;\n    border-radius: 50%;\n    width: 20px;\n    height: 20px;\n    text-align: center;\n    font-size: 12px;\n    line-height: 1.5;\n    font-weight: 500;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-family: 'InterMedium';\n}\n\n.filter-title-text {\n    font-size: 15px;\n    line-height: 1.5;\n    font-weight: 600;\n}\n\n.clear-all-text {\n    font-size: 15px;\n    line-height: 1.5;\n    font-weight: 400;\n    color: #0b6f85;\n    cursor: pointer;\n}\n\n.common-filter-title {\n    font-size: 13px;\n    line-height: 1.6;\n    color: #42296e;\n    font-weight: 500;\n}\n\n.common-filter-label {\n    font-size: 13px;\n    line-height: 1.6;\n    font-weight: 600;\n}\n\n.filter-title-text:focus-visible,\n.clear-all-text:focus-visible,\n.common-filter-title:focus-visible,\n.common-filter-label:focus-visible {\n    outline-color: #0b6f85;\n    outline-offset: 5px;\n}\n/* common Filter Menu styles end */\n\n/* commonBanner styles */\n\n.server-banner-wrapper {\n    font-size: 14px;\n    padding: 8px 10px;\n    border: 2px solid #0b6f85;\n    border-radius: 8px;\n    background-color: #eefbfe;\n}\n\n.common-expandable-banner-text-container {\n    overflow: hidden;\n    line-height: 20px;\n    align-self: center;\n    padding-bottom: 5px;\n    transition: height 0.5s;\n\n    height: 23px;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n\n    @supports (-webkit-line-clamp: 2) {\n        height: 43px;\n        white-space: normal;\n        display: -webkit-box;\n        -webkit-line-clamp: 2;\n        -webkit-box-orient: vertical;\n    }\n}\n\n.common-expandable-banner-text-container.expanded {\n    height: 125px;\n    white-space: normal;\n\n    @supports (-webkit-line-clamp: none) {\n        -webkit-line-clamp: none;\n    }\n}\n\n.common-expandable-banner-bottom-container {\n    display: flex;\n    justify-content: space-between;\n}\n\n.beta-icon-svg {\n    background: url(${m}) no-repeat\n        center;\n    height: 25px;\n    min-width: 40px;\n    align-self: center;\n    background-position: center;\n    background-size: contain;\n}\n\n.server-banner-expand-button {\n    color: #0b6f85;\n    align-self: center;\n    cursor: pointer;\n}\n\n.server-banner-expand-button:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 3px;\n    border-radius: 0.5px;\n}\n\n/* commonBanner styles end */\n\n.screen-reader-only {\n    position: absolute;\n    left: -99em;\n    height: 0;\n}\n\n.server-banner {\n    display: flex;\n    font-size: 14px;\n    padding: 8px 5px;\n    gap: 10px;\n    border: 2px solid #0b6f85;\n    border-radius: 8px;\n    background-color: #eefbfe;\n}\n\n.server-banner-icon-container {\n    min-width: 24px;\n    height: 24px;\n    align-self: center;\n}\n\n.server-banner-text-container {\n    align-self: center;\n    line-height: 20px;\n}\n\n.hidden-link {\n    color: #42296e;\n    text-decoration: none;\n    font-weight: 600;\n    margin-right: 10px;\n}\n\n.hidden-link-container svg {\n    transition: transform 0.2s ease-in-out;\n}\n\n.hidden-link:hover {\n    text-decoration: underline;\n}\n\n.hidden-link-container:hover svg {\n    transform: scale(1.1);\n    transition: transform 0.2s ease-in-out;\n}\n\n.hidden-link-container {\n    text-align: center;\n    margin-top: 24px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n/* Common Table Styles */\n\n.common-table-cell-inner-container {\n    max-height: 40px;\n    height: 40px;\n    box-sizing: border-box;\n    overflow: hidden;\n    display: flex;\n    flex-wrap: wrap;\n    align-content: center;\n\n    /* styles for browsers that do not support line clamp */\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    padding: 10px 0;\n\n    @supports (-webkit-line-clamp: 2) {\n        display: -webkit-box;\n        -webkit-line-clamp: 2;\n        -webkit-box-orient: vertical;\n        white-space: normal;\n        padding: 0;\n    }\n}\n\n.empty-table-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    height: max(280px, 100%);\n    gap: 25px;\n}\n\n.empty-table-text-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 20px;\n}\n\n/* Common Table Styles End */\n`,""]);const E=D},46101(e){"use strict";e.exports="data:image/svg+xml;base64,"},46298(e,t,i){"use strict";function n(e,t){return t.reduce(functio