x:hover {\n}\n.server-banner-x.Mui-focusVisible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 3px;\n    border: 0 !important;\n}\n\n.event-banner-container {\n    background: linear-gradient(270deg, #170098, #0d0054);\n    color: white;\n    filter: none;\n}\n\n.event-banner-content {\n    display: flex;\n    flex-direction: row;\n    gap: 5px;\n    align-items: center;\n    padding: 9px;\n}\n\n.event-banner-prefix {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    background-image: linear-gradient(315deg, #dfd1ff, #b2ffff);\n    background-clip: text;\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.event-banner-title {\n    font-size: 16px;\n    color: #efefef;\n    margin-right: 13px;\n}\n.event-banner-link {\n    color: #11007a !important;\n    font-size: 14px !important;\n    align-items: center;\n    display: flex;\n    flex-direction: row;\n    gap: 6px;\n}\n.banner-stars-start {\n    position: absolute;\n    top: -13px;\n    left: 0px;\n    height: 70px;\n}\n.banner-stars-end {\n    position: absolute;\n    top: -13px;\n    right: 0px;\n    height: 70px;\n}\n\n.event-banner-stars-container {\n    position: absolute;\n    left: 0px;\n    right: 0px;\n    top: 0px;\n    bottom: 0px;\n    display: flex;\n    flex-direction: row;\n    justify-content: space-around;\n    align-items: center;\n}\n\n.common-primary-banner {\n    display: flex;\n    flex-direction: row;\n    gap: 10px;\n    padding: 10px;\n    border-radius: 10px;\n\n    background-color: #f9f8ff;\n    border: 1px solid #c0b9ec;\n\n    color: #333333;\n}\n\n.common-primary-banner > svg {\n    min-width: 24px;\n    transform: scaleX(-100%);\n}\n\n.lms-banner-container {\n    display: flex;\n    background: linear-gradient(180deg, #fbf8ff 0%, #f4f1ff 100%);\n    border: 2px solid #ebddff;\n    border-radius: 12px;\n    padding: 15px;\n}\n\n.lms-banner-container.canvas {\n    margin-bottom: 10px;\n}\n\n.lms-banner-container.schoology-banner {\n    margin: 15px 0px 0px 0px;\n}\n.lms-banner-container.d2l {\n    margin-top: 30px;\n}\n.lms-banner-container.d2l .lms-banner-content {\n    font-size: medium;\n}\n.lms-banner-container.schoology-banner .lms-banner-content {\n    font-size: medium;\n}\n.lms-banner-container.bb-original {\n    margin-left: 30px;\n    margin-right: 30px;\n}\n\n.lms-banner-title {\n    all: unset;\n    font-family: inherit;\n    font-weight: 600;\n    color: #7e35b6;\n    display: block;\n}\n\n.lms-banner-container.moodle .lms-banner-title {\n    font-size: 1.14em;\n}\n.lms-banner-container.d2l .lms-banner-title,\n.lms-banner-container.schoology-banner .lms-banner-title,\n.lms-banner-container.canvas .lms-banner-title {\n    font-size: 1.13em;\n}\n.lms-banner-container.bb-original .lms-banner-title {\n    font-size: 1.16em;\n}\n.lms-banner-container.blackboard-rest .lms-banner-title {\n    font-size: 1.15em;\n}\n\n.lms-banner-content {\n    display: flex;\n    align-items: center;\n    flex-direction: row;\n    gap: 15px;\n    width: 100%;\n}\n\n.lms-banner-main-content {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 15px;\n}\n\n.lms-banner-main-content {\n    flex: 1;\n}\n\n#panoramaLMSEmbeddedQuickRemediationBannerContainer {\n    container-name: panoramaLMSEmbeddedBanner;\n    container-type: inline-size;\n}\n\n@container panoramaLMSEmbeddedBanner (min-width: 400px) and (max-width: 665px) {\n    .lms-banner-container.canvas .lms-banner-main-content {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n}\n\n@container panoramaLMSEmbeddedBanner (min-width: 465px) and (max-width: 625px) {\n    .lms-banner-container.d2l .lms-banner-main-content {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n}\n\n#panoramaLMSEmbeddedQuickRemediationBannerContainer .visualizer-guide-button {\n    flex-shrink: 0;\n}\n\n#panoramaLMSEmbeddedQuickRemediationBannerContainer .lms-score-container {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    box-sizing: border-box;\n    aspect-ratio: 1 / 1;\n    min-width: 78px;\n    border: 2px solid #c76cfe99;\n    border-radius: 50%;\n    box-shadow:\n        inset 0px 0px 2.75px 4px #c76cfe33,\n        0px 0px 2.75px 4px #c76cfe33;\n}\n\n#panoramaLMSEmbeddedQuickRemediationBannerContainer\n    .lms-score-container\n    .lms-score-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    font-size: 15px;\n    line-height: 1;\n    color: #874bd3;\n}\n\n.lms-score-container strong {\n    font-weight: 700;\n    font-size: 16px;\n}\n\n@media (max-width: 680px) {\n    .server-banner-container.expanded {\n        min-width: unset;\n        width: 100%;\n        max-height: unset;\n        height: 150px;\n    }\n    .server-banner-content {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n    .lms-banner-content {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n    .lms-banner-main-content {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n}\n\n/* ---------- Visualizer Banner on different panels ---------- */\n.server-banner-container button.visualizer-guide-button {\n    min-width: max-content;\n}\n\n.my-content-page-container > .server-banner-container {\n    margin-left: 10px;\n    margin-right: 10px;\n    &.expanded {\n        margin-top: 10px;\n        margin-bottom: 0px;\n    }\n}\n.marketplace-content-container > .server-banner-container {\n    margin-left: 10px;\n    margin-right: 10px;\n    &.expanded {\n        margin-top: 10px;\n        margin-bottom: 10px;\n    }\n}\n.institution-page-content-container:has(.institution-report-container)\n    > .server-banner-container.expanded {\n    margin-bottom: 10px;\n}\n.institution-page-content-container:has(.workflow-page)\n    > .server-banner-container.expanded {\n