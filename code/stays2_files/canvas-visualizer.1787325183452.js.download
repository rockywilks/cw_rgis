: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    width: fit-content;\n}\n\n#smartSpeakerButtonsModalContainer {\n    padding: 0px 8px;\n}\n\n#smartSpeakerButtonsContainer img {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n#smartSpeakerAIActionsButton,\n#smartSpeakerActionButtons {\n    padding: 2px;\n    display: inline-flex;\n    border-radius: 7px;\n    background-repeat: no-repeat;\n    background-position: center;\n    border: 2px solid transparent;\n}\n\n#smartSpeakerAIActionsButton,\n#smartSpeakerActionButtons.active:hover {\n    background-color: #ececec;\n}\n\n#smartSpeakerActionButtons.inactive:hover {\n    background-color: transparent !important;\n}\n\n#smartSpeakerAIActionsButton,\n#smartSpeakerActionButtons:focus-visible {\n    border: 2px solid #0b6f85;\n    box-shadow: none !important;\n    outline: none !important;\n}\n\n#progressBarContainer {\n    height: 4px;\n    background-color: #efecf6;\n    border-radius: 25px;\n}\n\n#progressBarHead {\n    height: 4px;\n    background-color: #42296e;\n    border-radius: 25px;\n    width: 0;\n    transition: width 0.2s linear;\n}\n\n.progressBarHeadEmbedded {\n    height: 4px;\n    background-color: #42296e;\n    border-radius: 25px;\n    width: 0;\n    transition: width 0.2s linear;\n}\n\n#smartSpeakerDraggableLogoIcon {\n    min-width: 32px;\n    min-height: 32px;\n    padding: 4px;\n    box-sizing: initial;\n}\n\n#smartSpeakerDraggable {\n    background-image: url(${J});\n}\n\n#smartSpeakerDraggable:active {\n    background-image: url(${X});\n}\n\n@media all and (max-width: 450px) {\n    #smartSpeakerDraggable {\n        min-width: 30px;\n        min-height: 30px;\n        opacity: 0.75;\n    }\n}\n\n.smart-speaker-volume-slider {\n    height: 69px;\n    position: absolute;\n    bottom: 40px;\n    right: -3px;\n    padding: 10px 0px;\n    border-radius: 6.8px;\n    border: 1px solid #cdcbd0;\n    background-color: rgba(255, 255, 255, 0